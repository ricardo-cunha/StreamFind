# Compile package sources with C++17 and OpenMP support.
CXX_STD = CXX17
.DEFAULT_GOAL := all

OPENBABEL_ROOT = core/external/openbabel/openbabel-3-2-0
OPENBABEL_DATA_ROOT = core/external/openbabel/openbabel-3-2-0/data

include core/external/openbabel/Makevars.openbabel

OPENBABEL_BUILD_ROOT = core/external/openbabel/build/linux
OPENBABEL_OPEN_LIB = $(OPENBABEL_BUILD_ROOT)/lib/libopenbabel_streamfind.a
OPENBABEL_INCHI_LIB = $(OPENBABEL_BUILD_ROOT)/lib/libinchi_streamfind.a

PKG_CPPFLAGS += -Icore -Icore/asm -Icore/external -Icore/json -Icore/mass_spec -Icore/nta -Icore/project
PKG_CPPFLAGS += -Icore/external/simdutf -Icore/external/nlohmann -Icore/external/json-schema-validator/src -Icore/external/pugixml-1.14/src
PKG_CPPFLAGS += -I$(OPENBABEL_ROOT)/include -I$(OPENBABEL_ROOT)/include/inchi -I$(OPENBABEL_ROOT)/src -I$(OPENBABEL_DATA_ROOT) -I$(OPENBABEL_ROOT)/src/formats/libinchi -DTARGET_API_LIB

override SOURCES = RcppExports.cpp
override SOURCES += $(filter-out RcppExports.cpp, $(wildcard *.cpp))
override SOURCES += core/external/simdutf_wrapper.cpp
override SOURCES += core/external/openbabel_adapter.cpp
override SOURCES += $(wildcard core/external/json-schema-validator/src/*.cpp)
override SOURCES += $(wildcard core/json/*.cpp)
override SOURCES += $(wildcard core/asm/*.cpp)
override SOURCES += $(wildcard core/project/*.cpp)
override SOURCES += $(wildcard core/nta/*.cpp)
override SOURCES += $(wildcard core/mass_spec/*.cpp)

# Keep simdutf compiled through the wrapper rather than as raw source files.
override SOURCES := $(filter-out core/external/simdutf/simdutf.cpp core/external/simdutf/amalgamation_demo.cpp, $(SOURCES))

override OBJECTS := $(patsubst %.cpp,%.o,$(SOURCES))

$(OPENBABEL_OPEN_LIB): $(OB_CXX_OBJECTS)
	@mkdir -p "$(dir $@)"
	$(AR) rcs $@ $^

$(OPENBABEL_INCHI_LIB): $(OB_C_OBJECTS)
	@mkdir -p "$(dir $@)"
	$(AR) rcs $@ $^

.PHONY: prepare_inst_resources
prepare_inst_resources: $(OPENBABEL_OPEN_LIB) $(OPENBABEL_INCHI_LIB)
	@mkdir -p "../inst/extdata/openbabel"
	@rm -rf "../inst/extdata/openbabel/data"
	@cp -R "$(OPENBABEL_DATA_ROOT)" "../inst/extdata/openbabel/data"

.PHONY: cleanup_openbabel_build
cleanup_openbabel_build:
	@if [ -n "$(R_PACKAGE_DIR)" ]; then \
		rm -rf "core/external/openbabel/build"; \
	fi

# Let R's standard shlib.mk keep ownership of the actual .so link command.
# We only add the vendored OpenBabel/InChI archives as extra prerequisites.
$(SHLIB): $(OPENBABEL_OPEN_LIB) $(OPENBABEL_INCHI_LIB)

all: prepare_inst_resources $(SHLIB) cleanup_openbabel_build

PKG_CXXFLAGS += $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS += $(SHLIB_OPENMP_CXXFLAGS)
# Force-link all objects from the vendored OpenBabel static archive so format
# plugins (e.g. SVG) that register themselves via static initialisation are
# not stripped by the linker.  Without --whole-archive the SVG format output
# returns empty on Linux.
PKG_LIBS += -Wl,--whole-archive $(OPENBABEL_OPEN_LIB) -Wl,--no-whole-archive
PKG_LIBS += $(OPENBABEL_INCHI_LIB) -lz

# Link against the vendored DuckDB build.
PKG_CPPFLAGS += -Icore/external/duckdb/include
PKG_LIBS += core/external/duckdb/lib/linux-x64/libduckdb_static.a
