# Compile package sources with C++17 and OpenMP support.
CXX_STD = CXX17
.DEFAULT_GOAL := all

OPENBABEL_ROOT = core/external/openbabel/openbabel-3-2-0
OPENBABEL_DATA_ROOT = core/external/openbabel/openbabel-3-2-0/data

OB_CXX_DEFINES = -DHAVE_ISFINITE=1 -D__USE_MINGW_ANSI_STDIO=1 -Dstreamfind_OPENBABEL_BUILD_DLL
OB_C_DEFINES = -DHAVE_ISFINITE=1 -D__USE_MINGW_ANSI_STDIO=1

include core/external/openbabel/Makevars.openbabel

OPENBABEL_BUILD_ROOT = core/external/openbabel/build/windows
OPENBABEL_RUNTIME_DLL = ../inst/libs/openbabel_streamfind.dll

PKG_CPPFLAGS += -Icore -Icore/asm -Icore/external -Icore/json -Icore/mass_spec -Icore/nta -Icore/project
PKG_CPPFLAGS += -Icore/external/simdutf -Icore/external/nlohmann -Icore/external/json-schema-validator/src -Icore/external/pugixml-1.14/src
PKG_CPPFLAGS += -I$(OPENBABEL_ROOT)/include -I$(OPENBABEL_ROOT)/include/inchi -I$(OPENBABEL_ROOT)/src -I$(OPENBABEL_DATA_ROOT) -I$(OPENBABEL_ROOT)/src/formats/libinchi -DTARGET_API_LIB

SOURCES = RcppExports.cpp
SOURCES += $(filter-out RcppExports.cpp, $(wildcard *.cpp))
SOURCES += core/external/simdutf_wrapper.cpp
SOURCES += core/external/openbabel_adapter.cpp
SOURCES += $(wildcard core/external/json-schema-validator/src/*.cpp)
SOURCES += $(wildcard core/project/*.cpp)
SOURCES += $(wildcard core/json/*.cpp)
SOURCES += $(wildcard core/asm/*.cpp)
SOURCES += $(wildcard core/nta/*.cpp)
SOURCES += $(wildcard core/mass_spec/*.cpp)

# Keep simdutf compiled through the wrapper rather than as raw source files.
SOURCES := $(filter-out core/external/simdutf/simdutf.cpp core/external/simdutf/amalgamation_demo.cpp, $(SOURCES))

OBJECTS = $(patsubst %.cpp,%.o,$(SOURCES))

$(OPENBABEL_RUNTIME_DLL): $(OB_CXX_OBJECTS) $(OB_C_OBJECTS)
	@mkdir -p "$(dir $@)"
	$(CXX17) $(CXX17STD) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(CXX17FLAGS) -shared -o $@.tmp $^ -lz $(SHLIB_OPENMP_CXXFLAGS)
	@mv -f $@.tmp $@
	cp "core/external/duckdb/lib/windows-x64/duckdb.dll" "$(dir $@)"

.PHONY: prepare_inst_resources
prepare_inst_resources: $(OPENBABEL_RUNTIME_DLL)
	@mkdir -p "../inst/extdata/openbabel"
	@rm -rf "../inst/extdata/openbabel/data"
	@cp -R "$(OPENBABEL_DATA_ROOT)" "../inst/extdata/openbabel/data"

# During R CMD INSTALL (R_PACKAGE_DIR is set) also copy to the final destination.
.PHONY: copy_installed_dlls
copy_installed_dlls: $(SHLIB)
	@if [ -n "$(R_PACKAGE_DIR)" ]; then \
		dest="$(R_PACKAGE_DIR)/libs$(R_ARCH)"; \
		mkdir -p "$$dest"; \
		cp "$(OPENBABEL_RUNTIME_DLL)" "$$dest/"; \
		cp "../inst/libs/duckdb.dll" "$$dest/"; \
	fi

# Only clean build artifacts during R CMD INSTALL; leave them for development.
.PHONY: cleanup_openbabel_build
cleanup_openbabel_build:
	@if [ -n "$(R_PACKAGE_DIR)" ]; then \
		rm -rf "core/external/openbabel/build"; \
	fi

all: prepare_inst_resources $(SHLIB) copy_installed_dlls cleanup_openbabel_build

$(SHLIB): $(OPENBABEL_RUNTIME_DLL)

%.o: %.cpp
	@mkdir -p "$(dir $@)"
	$(CXX17) $(CXX17STD) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(CXX17FLAGS) $(CXX17PICFLAGS) -c $< -o $@

PKG_CXXFLAGS += $(SHLIB_OPENMP_CXXFLAGS) -D__USE_MINGW_ANSI_STDIO
PKG_LIBS += $(SHLIB_OPENMP_CXXFLAGS) -lz

# Link against the vendored DuckDB build.
PKG_CPPFLAGS += -Icore/external/duckdb/include
PKG_LIBS += -Lcore/external/duckdb/lib/windows-x64/ -lduckdb
