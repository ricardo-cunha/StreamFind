# OpenBabel build rules — included by src/Makevars and src/Makevars.win
# All paths are relative to src/ (the directory containing Makevars)

OB_ROOT_DIR = core/external/openbabel/openbabel-3-2-0
OB_DATA_ROOT = $(OB_ROOT_DIR)/data
OB_MANIFEST_DIR = core/external/openbabel/build_manifest
OB_CAPI = core/external/openbabel/openbabel_c_api.cpp

OB_INCLUDES = -I$(OB_ROOT_DIR)/include -I$(OB_ROOT_DIR)/include/inchi -I$(OB_ROOT_DIR)/src -I$(OB_DATA_ROOT) -I$(OB_ROOT_DIR)/src/formats/libinchi -Icore/external/openbabel/inchi-iupac-1.07.5/src -Icore/external/openbabel/INCHI_BASE/src -DTARGET_API_LIB

# Read OpenBabel C++ sources from manifest (strip leading src/ — manifest paths
# are repo-root-relative but Makevars runs from src/).
OB_CXX_SOURCES = $(patsubst src/%,%,$(shell grep -v '^#' $(OB_MANIFEST_DIR)/openbabel_cpp.txt)) $(OB_CAPI)

# InChI C sources: individual files plus the libinchi glob.
OB_C_SOURCES = $(shell find core/external/openbabel/openbabel-3-2-0/src/formats/libinchi -name '*.c' 2>/dev/null) \
    core/external/openbabel/inchi-iupac-1.07.5/src/ichilnct.c \
    core/external/openbabel/inchi-iupac-1.07.5/src/inchi_dll_a.c \
    core/external/openbabel/inchi-iupac-1.07.5/src/inchi_dll_b.c \
    core/external/openbabel/inchi-iupac-1.07.5/src/inchi_dll_main.c

OB_OBJ_DIR = core/external/openbabel/build/obj
OB_CXX_OBJECTS = $(addprefix $(OB_OBJ_DIR)/,$(OB_CXX_SOURCES:.cpp=.o))
OB_C_OBJECTS = $(addprefix $(OB_OBJ_DIR)/,$(OB_C_SOURCES:.c=.o))



$(OB_OBJ_DIR)/%.o: %.cpp
	@mkdir -p "$(dir $@)"
	$(CXX17) $(CXX17STD) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(CXX17FLAGS) $(CXX17PICFLAGS) -w $(OB_INCLUDES) $(OB_CXX_DEFINES) -c $< -o $@

$(OB_OBJ_DIR)/%.o: %.c
	@mkdir -p "$(dir $@)"
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(CPICFLAGS) -w $(OB_INCLUDES) $(OB_C_DEFINES) -c $< -o $@
