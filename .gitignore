# Repository build outputs -----------------------------------------------------
/build/
/dist/
/cmake-build-*/
/core/build/
/integrations/cf-streamfind/build/
/site/
**/CMakeCache.txt
**/CMakeFiles/
**/.ninja_deps
**/.ninja_log
_skbuild/

# Native and language build artifacts ------------------------------------------
**/*.o
**/*.obj
**/*.a
**/*.lib
**/*.so
**/*.dll
**/*.dylib
**/*.pyd
**/*.egg-info/
/core/vendor/openbabel/build/

# Rust tooling ----------------------------------------------------------------
# Machine-local Cargo config (e.g. a per-user linker path); never commit.
rust/.cargo/

# Linked git worktrees ---------------------------------------------------------
# Nested git repositories (have their own .git file); local developer state.
.worktrees/

# DuckDB runtime/import libraries are vendored for native builds ----------------
!/core/vendor/duckdb/lib/
!/core/vendor/duckdb/lib/**

# Python tooling ----------------------------------------------------------------
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/.venv-wheel/

# Node/frontend tooling ---------------------------------------------------------
**/node_modules/
**/coverage/
**/.vite/

# Runtime and generated data ----------------------------------------------------
**/*.sqlite
**/*.duckdb
**/*.rds
**/*.sf
**/*.html
!/slides/**/*.html
!/docs/**/*.html
/log/
/cache/
/tmp/

# IDE and OS files --------------------------------------------------------------
*.Rproj.user/
*.Rhistory
*.RData
*.DS_Store
*.Rproj
*.vscode/
*.quarto/
