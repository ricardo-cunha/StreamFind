@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfcore:sensors
        a sf:Domain ;
        skos:prefLabel "sensors" ;
        skos:definition "Sensor data project domain." ;
        sf:guidance "Sensor workflow: create or describe the project, connect when using workflow methods, then discover methods with get_available_methods(domain=sensors)." .
