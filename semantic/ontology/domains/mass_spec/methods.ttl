@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfms: <https://streamfind.dev/catalogue/domains/mass_spec#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfms:loadChromatogramsMassSpecMethod
    a sf:Method ;
    sf:methodId "mass_spec.load_chromatograms" ;
    sf:availableInDomain sfcore:mass_spec ;
    skos:prefLabel "Load chromatograms" ;
    skos:definition "Load selected chromatograms from persisted mass spectrometry analyses into MASS_SPEC_CHROMATOGRAMS." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:chromatogramIdRegexParameter,
        sfms:ignoreCaseParameter,
        sfms:invertParameter ;
    sf:cacheable false ;
    sf:requiredMethods () ;
    sf:singleOccurrence true ;
    sf:reads sfms:analysesTable ;
    sf:writes sfms:chromatogramsTable ;
    sf:returns sfcore:operationStatusResult .

sfms:filterChromatogramsRetentionTimeMassSpecMethod
    a sf:Method ;
    sf:methodId "mass_spec.filter_chromatograms_retention_time" ;
    sf:availableInDomain sfcore:mass_spec ;
    skos:prefLabel "Filter chromatograms by retention time" ;
    skos:definition "Keep chromatogram rows whose retention time is within the inclusive minimum and maximum window." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:rtMinParameter,
        sfms:rtMaxParameter ;
    sf:cacheable false ;
    sf:requiredMethods () ;
    sf:singleOccurrence false ;
    sf:reads sfms:chromatogramsTable ;
    sf:writes sfms:chromatogramsTable ;
    sf:returns sfcore:operationStatusResult .

sfms:findFeaturesMassSpecMethod
    a sf:Method ;
    sf:methodId "mass_spec.find_features" ;
    sf:availableInDomain sfcore:mass_spec ;
    skos:prefLabel "Find mass spectrometry features" ;
    skos:definition "Group MS1 centroid traces within retention-time windows and persist detected NTA features." ;
    sf:hasParameter
        sfms:rtWindowsMinParameter,
        sfms:rtWindowsMaxParameter,
        sfcore:analysisNamesParameter,
        sfms:ppmThresholdParameter,
        sfms:noiseThresholdParameter,
        sfms:minSnrParameter,
        sfms:minTracesParameter,
        sfms:baselineWindowParameter,
        sfms:maxFeatureWidthParameter,
        sfms:baseQuantileParameter ;
    sf:cacheable true ;
    sf:requiredMethods () ;
    sf:singleOccurrence true ;
    sf:reads sfms:analysesTable ;
    sf:writes sfms:ntaFeaturesTable ;
    sf:returns sfcore:operationStatusResult .
