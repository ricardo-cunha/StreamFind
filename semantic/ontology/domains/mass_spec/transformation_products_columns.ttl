@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfms: <https://streamfind.dev/catalogue/domains/mass_spec#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Transformation-product assignment columns. Column names follow the persisted

# MASS_SPEC_NTA_TRANSFORMATION_PRODUCTS table (assembled from the in-memory

# NTA_TRANSFORMATION_PRODUCT_ROW structure), so the semantic surface matches the

# DuckDB schema exactly.

sfms:tpAnalysisColumn
    a sf:Column ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis" ;
    skos:definition "Analysis name of the assigned transformation product." ;
    sf:columnName "analysis" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfms:tpFeatureGroupColumn
    a sf:Column ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Feature group" ;
    skos:definition "Feature group the transformation product was assigned to." ;
    sf:columnName "feature_group" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfms:tpPrecursorFeatureGroupColumn
    a sf:Column ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Precursor feature group" ;
    skos:definition "Direct precursor feature group of the transformation product." ;
    sf:columnName "precursor_feature_group" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfms:tpMainPrecursorFeatureGroupColumn
    a sf:Column ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Main precursor feature group" ;
    skos:definition "Main precursor feature group of the transformation product." ;
    sf:columnName "main_precursor_feature_group" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfms:tpAssignmentRankColumn
    a sf:Column ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Assignment rank" ;
    skos:definition "Rank of the transformation-product candidate assignment." ;
    sf:columnName "assignment_rank" ;
    sf:type "integer" ;
    sf:storageType "INTEGER" .

sfms:tpNameColumn
    a sf:Column ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Name" ;
    skos:definition "Name of the transformation product." ;
    sf:columnName "name" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfms:tpFormulaColumn
    a sf:Column ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Formula" ;
    skos:definition "Molecular formula of the transformation product." ;
    sf:columnName "formula" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfms:tpMassColumn
    a sf:Column ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass" ;
    skos:definition "Monoisotopic mass of the transformation product." ;
    sf:columnName "mass" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfms:tpSmilesColumn
    a sf:Column ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "SMILES" ;
    skos:definition "SMILES structure of the transformation product." ;
    sf:columnName "SMILES" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

