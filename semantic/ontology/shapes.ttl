@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sfcore:SemanticEntryShape
    a sh:NodeShape ;
        sh:targetClass sf:Operation, sf:Method, sf:Domain, sf:Project, sf:Workflow, sf:Parameter, sf:Result, sf:Error, sf:Table, sf:Field, sf:Column ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path skos:definition ; sh:minCount 1 ; sh:datatype xsd:string ] .

sfcore:OperationShape
    a sh:NodeShape ;
    sh:targetClass sf:Operation ;
    sh:property [ sh:path sf:operationId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sf:toolName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sf:availableInDomain ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sf:Domain ] ;
    sh:property [ sh:path sf:returns ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sf:Result ] ;
    sh:property [ sh:path sf:mutatesProject ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .

sfcore:MethodShape
    a sh:NodeShape ;
    sh:targetClass sf:Method ;
    sh:property [ sh:path sf:methodId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sf:availableInDomain ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sf:Domain ] ;
    sh:property [ sh:path sf:hasParameter ; sh:class sf:Parameter ] ;
    sh:property [ sh:path sf:hasProperty ; sh:class sf:Field ] ;
    sh:property [ sh:path sf:reads ; sh:class sf:Table ] ;
    sh:property [ sh:path sf:writes ; sh:class sf:Table ] ;
    sh:property [ sh:path sf:returns ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sf:Result ] ;
    sh:sparql [
        sh:message "Mass-spec methods must declare at least one table they read." ;
        sh:select """
            SELECT $this
            WHERE {
                $this sf:availableInDomain sfcore:mass_spec .
                FILTER NOT EXISTS { $this sf:reads ?table . }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Mass-spec methods must declare at least one table they write." ;
        sh:select """
            SELECT $this
            WHERE {
                $this sf:availableInDomain sfcore:mass_spec .
                FILTER NOT EXISTS { $this sf:writes ?table . }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Mass-spec methods must expose every workflow method field." ;
        sh:select """
            SELECT $this
            WHERE {
                $this sf:availableInDomain sfcore:mass_spec .
                FILTER (
                    NOT EXISTS { $this sf:hasProperty sfcore:methodCacheableField . } ||
                    NOT EXISTS { $this sf:hasProperty sfcore:methodRequiredField . } ||
                    NOT EXISTS { $this sf:hasProperty sfcore:methodMaxOccurrencesField . }
                )
            }
        """
    ] .

sfcore:ParameterShape
    a sh:NodeShape ;
    sh:targetClass sf:Parameter ;
     sh:property [
         sh:path sf:type ;
         sh:minCount 1 ;
         sh:maxCount 1 ;
         sh:datatype xsd:string ;
         sh:in ( "string" "integer" "real" "boolean" "object" "array" "table" "binary" "timestamp" )
     ] ;
    sh:property [ sh:path sf:required ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path sf:example ; sh:minCount 1 ; sh:maxCount 1 ] ;
     sh:property [ sh:path sf:items ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:sparql [
        sh:message "Array parameters must declare exactly one sf:items schema." ;
        sh:select """
            SELECT $this
            WHERE {
                $this sf:type "array" .
                FILTER NOT EXISTS { $this sf:items ?items . }
            }
        """
    ] .

sfcore:FixtureShape
    a sh:NodeShape ;
    sh:targetClass sf:Fixture ;
    sh:property [ sh:path sf:fixturePath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

sfcore:ErrorShape
    a sh:NodeShape ;
    sh:targetClass sf:Error ;
    sh:property [ sh:path sf:errorCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

sfcore:ResultShape
    a sh:NodeShape ;
    sh:targetClass sf:Result ;
     sh:property [
         sh:path sf:type ;
         sh:minCount 1 ;
         sh:maxCount 1 ;
         sh:datatype xsd:string ;
         sh:in ( "string" "integer" "real" "boolean" "object" "array" "table" )
     ] ;
    sh:property [ sh:path sf:hasProperty ; sh:class sf:Field ] ;
    sh:property [ sh:path sf:items ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:sparql [
        sh:message "Array results must declare exactly one sf:items schema." ;
        sh:select """
            SELECT $this
            WHERE {
                $this sf:type "array" .
                FILTER NOT EXISTS { $this sf:items ?items . }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Table results must declare at least one result column." ;
        sh:select """
            SELECT $this
            WHERE {
                $this sf:type "table" .
                FILTER NOT EXISTS { $this sf:hasProperty ?column . }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Table results must use columns for every property." ;
        sh:select """
            SELECT $this
            WHERE {
                $this sf:type "table" ;
    sf:hasProperty ?property .
                FILTER NOT EXISTS { ?property a sf:Column . }
            }
        """
    ] .

sfcore:TableShape
    a sh:NodeShape ;
    sh:targetClass sf:Table ;
    sh:property [ sh:path sf:tableName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sf:hasColumn ; sh:minCount 1 ; sh:class sf:Column ] .

sfcore:ColumnShape
    a sh:NodeShape ;
    sh:targetClass sf:Column ;
    sh:property [ sh:path sf:columnName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
     sh:property [
         sh:path sf:type ;
         sh:minCount 1 ;
         sh:maxCount 1 ;
         sh:datatype xsd:string ;
         sh:in ( "string" "integer" "real" "boolean" "object" "array" "table" "binary" "timestamp" )
     ] ;
    sh:property [ sh:path sf:propertyName ; sh:maxCount 0 ] ;
    sh:property [ sh:path sf:storageType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:sparql [
        sh:message "Every column must be referenced by a persisted table or table result." ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { ?table sf:hasColumn $this . }
                FILTER NOT EXISTS {
                    ?result sf:type "table" ;
    sf:hasProperty $this .
                }
            }
        """
    ] .

sfcore:FieldShape
    a sh:NodeShape ;
    sh:targetClass sf:Field ;
     sh:property [
         sh:path sf:type ;
         sh:minCount 1 ;
         sh:maxCount 1 ;
         sh:datatype xsd:string ;
         sh:in ( "string" "integer" "real" "boolean" "object" "array" "table" "binary" "timestamp" )
     ] ;
    sh:property [ sh:path sf:propertyName ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sf:required ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path sf:example ; sh:maxCount 1 ] ;
    sh:property [ sh:path sf:hasProperty ; sh:class sf:Field ] ;
    sh:property [ sh:path sf:items ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:sparql [
        sh:message "Logical fields must declare exactly one JSON property name." ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { $this a sf:Column . }
                FILTER NOT EXISTS { $this a sf:Parameter . }
                FILTER NOT EXISTS { $this sf:propertyName ?name . }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Logical fields must not declare physical column metadata." ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { $this a sf:Column . }
                { $this sf:columnName ?value } UNION { $this sf:storageType ?value }
            }
        """
    ] .

sfcore:OperationStatusFieldShape
    a sh:NodeShape ;
    sh:targetNode sfcore:statusField ;
    sh:property [ sh:path sf:constraints ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "finished|failed" ] .
