@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

    sfcore:projectTable
        a sf:Table ;
        skos:inScheme sfcore:scheme ;
        skos:prefLabel "Project table" ;
        skos:definition "Generic project identity, metadata, workflow, and framework state." ;
        sf:tableName "PROJECT" ;
        sf:hasColumn sfcore:projectIdColumn, sfcore:projectDomainColumn, sfcore:projectMetadataColumn, sfcore:projectWorkflowColumn, sfcore:createdAtColumn, sfcore:schemaVersionColumn, sfcore:frameworkVersionColumn .

    sfcore:cacheTable
        a sf:Table ;
        skos:inScheme sfcore:scheme ;
        skos:prefLabel "Cache table" ;
        skos:definition "Cached workflow results owned by a project." ;
        sf:tableName "CACHE" ;
        sf:hasColumn sfcore:projectIdColumn, sfcore:cacheNameColumn, sfcore:cacheDescriptionColumn, sfcore:cacheHashColumn, sfcore:cacheDataColumn, sfcore:createdAtColumn .

    sfcore:auditTrailTable
        a sf:Table ;
        skos:inScheme sfcore:scheme ;
        skos:prefLabel "Audit trail table" ;
        skos:definition "Persisted project and workflow operation audit events." ;
        sf:tableName "AUDIT_TRAIL" ;
        sf:hasColumn sfcore:projectIdColumn, sfcore:operationTypeColumn, sfcore:objectTypeColumn, sfcore:operationDetailsColumn, sfcore:createdAtColumn .

    sfcore:projectIdColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Project ID" ; skos:definition "Logical project identifier." ;
        sf:columnName "project_id" ; sf:type "VARCHAR" .
    sfcore:projectDomainColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Domain" ; skos:definition "Immutable project domain." ;
        sf:columnName "domain" ; sf:type "VARCHAR" .
    sfcore:projectMetadataColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Metadata" ; skos:definition "Project metadata JSON." ;
        sf:columnName "metadata" ; sf:type "JSON" .
    sfcore:projectWorkflowColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Workflow" ; skos:definition "Persisted workflow JSON." ;
        sf:columnName "workflow" ; sf:type "JSON" .
    sfcore:createdAtColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Created at" ; skos:definition "Creation timestamp." ;
        sf:columnName "created_at" ; sf:type "TIMESTAMP" .
    sfcore:schemaVersionColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Schema version" ; skos:definition "Project schema version." ;
        sf:columnName "schema_version" ; sf:type "INTEGER" .
    sfcore:frameworkVersionColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Framework version" ; skos:definition "StreamFind framework version." ;
        sf:columnName "framework_version" ; sf:type "VARCHAR" .
    sfcore:cacheNameColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Cache name" ; skos:definition "Cache entry name." ;
        sf:columnName "name" ; sf:type "VARCHAR" .
    sfcore:cacheDescriptionColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Cache description" ; skos:definition "Cache entry description." ;
        sf:columnName "description" ; sf:type "VARCHAR" .
    sfcore:cacheHashColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Cache hash" ; skos:definition "Cache entry content hash." ;
        sf:columnName "hash" ; sf:type "VARCHAR" .
    sfcore:cacheDataColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Cache data" ; skos:definition "Serialized cached result." ;
        sf:columnName "data" ; sf:type "BLOB" .
    sfcore:operationTypeColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Operation type" ; skos:definition "Audit operation category." ;
        sf:columnName "operation_type" ; sf:type "VARCHAR" .
    sfcore:objectTypeColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Object type" ; skos:definition "Audited object category." ;
        sf:columnName "object_type" ; sf:type "VARCHAR" .
    sfcore:operationDetailsColumn
        a sf:Column ; skos:inScheme sfcore:scheme ; skos:prefLabel "Operation details" ; skos:definition "Audit details JSON." ;
        sf:columnName "operation_details" ; sf:type "JSON" .
