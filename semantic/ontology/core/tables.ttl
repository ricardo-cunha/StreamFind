@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfcore:projectTable
    a sf:Table ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Project table" ;
    skos:definition "Generic project identity, metadata, workflow, and framework state." ;
    sf:tableName "PROJECT" ;
    sf:hasColumn
        sfcore:projectIdColumn,
        sfcore:projectDomainColumn,
        sfcore:projectMetadataColumn,
        sfcore:projectWorkflowColumn,
        sfcore:createdAtColumn,
        sfcore:schemaVersionColumn,
        sfcore:frameworkVersionColumn .

sfcore:cacheTable
    a sf:Table ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Cache table" ;
    skos:definition "Cached workflow results owned by a project." ;
    sf:tableName "CACHE" ;
    sf:hasColumn
        sfcore:projectIdColumn,
        sfcore:cacheNameColumn,
        sfcore:cacheDescriptionColumn,
        sfcore:cacheHashColumn,
        sfcore:cacheDataColumn,
        sfcore:createdAtColumn .

sfcore:auditTrailTable
    a sf:Table ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Audit trail table" ;
    skos:definition "Persisted project and workflow operation audit events." ;
    sf:tableName "AUDIT_TRAIL" ;
    sf:hasColumn
        sfcore:projectIdColumn,
        sfcore:operationTypeColumn,
        sfcore:objectTypeColumn,
        sfcore:operationDetailsColumn,
        sfcore:createdAtColumn .

sfcore:workflowExecutionTable
    a sf:Table ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow execution table" ;
    skos:definition "Persisted status and cache identity for every workflow step." ;
    sf:tableName "WORKFLOW_EXECUTION" ;
    sf:hasColumn
        sfcore:projectIdColumn,
        sfcore:workflowRevisionColumn,
        sfcore:stepIndexColumn,
        sfcore:executionMethodColumn,
        sfcore:parameterHashColumn,
        sfcore:executionStatusColumn,
        sfcore:startedAtColumn,
        sfcore:completedAtColumn,
        sfcore:executionErrorColumn,
        sfcore:cacheKeyColumn .
