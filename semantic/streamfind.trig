@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

{
	sfcore:scheme
		a skos:ConceptScheme ;
		skos:prefLabel "streamfind core semantic catalogue" ;
		skos:definition "Canonical semantic declarations for generic streamfind operations and interfaces." .

	sfcore:streamfind
		a sf:Domain ;
		skos:prefLabel "streamfind generic project contract" ;
		skos:definition "The generic project contract shared by streamfind backends." .

	sfcore:success
		a sf:Result ;
		skos:prefLabel "Successful result" ;
		skos:definition "A capability completed without a semantic error." .

	sfcore:invalidArgument
		a sf:Error ;
		skos:prefLabel "Invalid argument" ;
		skos:definition "A required argument is missing or has an invalid value." ;
		sf:errorCode "InvalidArgument" .

	sfcore:projectNotFound
		a sf:Error ;
		skos:prefLabel "Project not found" ;
		skos:definition "The requested project database or project identifier does not exist." ;
		sf:errorCode "ProjectNotFound" .

	sfcore:create
		a sf:Operation ;
		sf:operationId "create" ;
		skos:prefLabel "Create a project" ;
		skos:definition "Create a persisted project with an immutable domain." ;
		sf:availableInDomain sfcore:streamfind ;
		sf:toolName "create" ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId, sfcore:domain .

	sfcore:describe
		a sf:Operation ;
		sf:operationId "describe" ;
		skos:prefLabel "Describe a project" ;
		skos:definition "Read a project's identity and persisted metadata." ;
		sf:toolName "describe" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:validate
		a sf:Operation ;
		sf:operationId "validate" ;
		skos:prefLabel "Validate a project" ;
		skos:definition "Validate a project's schema and persisted state." ;
		sf:toolName "validate" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:getDomain
		a sf:Operation ;
		sf:operationId "get_domain" ;
		skos:prefLabel "Read the project domain" ;
		skos:definition "Read the immutable domain assigned to a project." ;
		sf:toolName "get_domain" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:getMetadata
		a sf:Operation ;
		sf:operationId "get_metadata" ;
		skos:prefLabel "Read project metadata" ;
		skos:definition "Return the metadata stored for a project." ;
		sf:toolName "get_metadata" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:setMetadata
		a sf:Operation ;
		sf:operationId "set_metadata" ;
		skos:prefLabel "Set project metadata" ;
		skos:definition "Replace the metadata stored for a project." ;
		sf:toolName "set_metadata" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId, sfcore:metadata .

	sfcore:getWorkflow
		a sf:Operation ;
		sf:operationId "get_workflow" ;
		skos:prefLabel "Read the project workflow" ;
		skos:definition "Return the persisted workflow for a project." ;
		sf:toolName "get_workflow" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:setWorkflow
		a sf:Operation ;
		sf:operationId "set_workflow" ;
		skos:prefLabel "Set the project workflow" ;
		skos:definition "Validate and persist a project's workflow." ;
		sf:toolName "set_workflow" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId, sfcore:workflow .

	sfcore:validateWorkflow
		a sf:Operation ;
		sf:operationId "validate_workflow" ;
		skos:prefLabel "Validate a workflow" ;
		skos:definition "Validate workflow methods, ordering, domains, and parameters." ;
		sf:toolName "validate_workflow" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:workflow .

	sfcore:runWorkflow
		a sf:Operation ;
		sf:operationId "run_workflow" ;
		skos:prefLabel "Run the project workflow" ;
		skos:definition "Execute the persisted workflow for a project." ;
		sf:toolName "run_workflow" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:getCache
		a sf:Operation ;
		sf:operationId "get_cache" ;
		skos:prefLabel "Read project cache" ;
		skos:definition "Return cache entries stored for a project." ;
		sf:toolName "get_cache" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:getCacheSize
		a sf:Operation ;
		sf:operationId "get_cache_size" ;
		skos:prefLabel "Read project cache size" ;
		skos:definition "Return the number of cache entries stored for a project." ;
		sf:toolName "get_cache_size" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:deleteCache
		a sf:Operation ;
		sf:operationId "delete_cache" ;
		skos:prefLabel "Delete project cache" ;
		skos:definition "Delete all cache entries stored for a project." ;
		sf:toolName "delete_cache" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:getAuditTrail
		a sf:Operation ;
		sf:operationId "get_audit_trail" ;
		skos:prefLabel "Read project audit events" ;
		skos:definition "Return audit events recorded for a project." ;
		sf:toolName "get_audit_trail" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:getAvailableMethods
		a sf:Operation ;
		sf:operationId "get_available_methods" ;
		skos:prefLabel "List methods registered for a domain" ;
		skos:definition "Return workflow methods registered for a domain." ;
		sf:toolName "get_available_methods" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:domain .

	sfcore:runMethod
		a sf:Operation ;
		sf:operationId "run_method" ;
		skos:prefLabel "Append and run a workflow method" ;
		skos:definition "Append a method to a project's workflow, validate it, and execute it." ;
		sf:toolName "run_method" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId, sfcore:method, sfcore:parameters .

	sfcore:copy
		a sf:Operation ;
		sf:operationId "copy" ;
		skos:prefLabel "Copy a project" ;
		skos:definition "Copy a project to another database and project identifier." ;
		sf:toolName "copy" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId, sfcore:destinationDatabasePath, sfcore:destinationProjectId .

	sfcore:close
		a sf:Operation ;
		sf:operationId "close" ;
		skos:prefLabel "Close a project handle" ;
		skos:definition "Close the project handle used by an operation." ;
		sf:toolName "close" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:connect
		a sf:Operation ;
		sf:operationId "connect" ;
		skos:prefLabel "Connect an MCP session to a project" ;
		skos:definition "Open a project and bind its immutable domain to an MCP session." ;
		sf:toolName "connect" ;
		sf:availableInDomain sfcore:streamfind ;
		sf:hasParameter sfcore:databasePath, sfcore:projectId .

	sfcore:databasePath
		a sf:Parameter ;
		skos:prefLabel "Database path" ;
		skos:definition "Filesystem path of the DuckDB project database." ;
		sf:type "string" ;
		sf:required true .

	sfcore:projectId
		a sf:Parameter ;
		skos:prefLabel "Project identifier" ;
		skos:definition "Logical project identifier within the database." ;
		sf:type "string" ;
		sf:required true .

	sfcore:domain
		a sf:Parameter ;
		skos:prefLabel "Project domain" ;
		skos:definition "Immutable domain assigned to a project." ;
		sf:type "string" ;
		sf:required true .

	sfcore:metadata
		a sf:Parameter ;
		skos:prefLabel "Project metadata" ;
		skos:definition "JSON object containing project-owned metadata." ;
		sf:type "object" ;
		sf:required true .

	sfcore:workflow
		a sf:Parameter ;
		skos:prefLabel "Workflow" ;
		skos:definition "Versioned ordered workflow definition." ;
		sf:type "object" ;
		sf:required true .

	sfcore:method
		a sf:Parameter ;
		skos:prefLabel "Method identifier" ;
		skos:definition "Stable identifier of a registered workflow method." ;
		sf:type "string" ;
		sf:required true .

	sfcore:parameters
		a sf:Parameter ;
		skos:prefLabel "Method parameters" ;
		skos:definition "JSON object containing method-specific parameter values." ;
		sf:type "object" ;
		sf:required false .

	sfcore:destinationDatabasePath
		a sf:Parameter ;
		skos:prefLabel "Destination database path" ;
		skos:definition "Filesystem path for the copied DuckDB project database." ;
		sf:type "string" ;
		sf:required true .

	sfcore:destinationProjectId
		a sf:Parameter ;
		skos:prefLabel "Destination project identifier" ;
		skos:definition "Logical identifier for the copied project." ;
		sf:type "string" ;
		sf:required true .

	sfcore:projectConformance
		a sf:Fixture ;
		skos:prefLabel "Project conformance fixture" ;
		skos:definition "Shared JSON fixture consumed by the C++ and Rust project tests." ;
		sf:fixturePath "core/tests/fixtures/project_conformance.json" .

	sfcore:analyses
		a sf:Parameter ;
		skos:prefLabel "Analyses" ;
		skos:definition "Array of analysis file records. Each record contains a path and may contain replicate_name and blank_name." ;
		sf:type "array" ;
		sf:required true ;
		sf:items sfcore:analysisFile .

	sfcore:analysisFile
		a sf:Parameter ;
		skos:prefLabel "Analysis file" ;
		skos:definition "One analysis file and optional replicate and blank labels." ;
		sf:type "object" ;
		sf:required true .

	sfcore:analysisNames
		a sf:Parameter ;
		skos:prefLabel "Analysis names" ;
		skos:definition "Array of analysis file names without filename extensions." ;
		sf:type "array" ;
		sf:required true .
}
