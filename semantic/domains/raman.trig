@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

{
	sfcore:raman
		a sf:Domain ;
		skos:prefLabel "raman" ;
		skos:definition "Raman spectroscopy project domain." .

	sfcore:ramanAddAnalyses
		a sf:Method ;
		sf:methodId "raman.add_analyses" ;
		sf:availableInDomain sfcore:raman ;
		skos:prefLabel "Add Raman analyses" ;
		skos:definition "Add Raman analysis files to a project." ;
		sf:toolName "add_analyses" ;
		sf:hasParameter sfcore:analyses ;
		sf:extensions "asc,sif" .

	sfcore:ramanRemoveAnalyses
		a sf:Method ;
		sf:methodId "raman.remove_analyses" ;
		sf:availableInDomain sfcore:raman ;
		skos:prefLabel "Remove Raman analyses" ;
		skos:definition "Remove Raman analysis files from a project." ;
		sf:toolName "remove_analyses" ;
		sf:hasParameter sfcore:analysisNames .
}
